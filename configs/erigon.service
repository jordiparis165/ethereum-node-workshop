[Unit]
Description=Erigon Ethereum Execution and Caplin Consensus Client
After=network-online.target
RequiresMountsFor=/data /var/lib/erigon-hot
Wants=network-online.target

[Service]
User=adm-mesifi
Group=adm-mesifi
Type=simple
ExecStart=/data/ethereum-src/erigon-v3.8.1/build/bin/erigon --chain=mainnet --datadir=/data/erigon --prune.mode=minimal --http --http.addr=127.0.0.1 --http.port=8545 --http.api=eth,net,web3 --http.vhosts=localhost --ws --ws.port=8546 --port=30303 --mcp.disable --metrics --metrics.addr=127.0.0.1 --metrics.port=6061
Restart=on-failure
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
